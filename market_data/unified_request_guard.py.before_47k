"""Atomic local provider-credit and request-budget authorization.

Research-only. No HTTP requests are performed here.
"""

import fcntl
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

from market_data.pre_request_credit_gate import check_before_request
from market_data.provider_credit_state import (
    DEFAULT_PATH,
    load_credit_state,
    save_credit_state,
)
from market_data.api_credit_monitor import CreditSnapshot
from market_data.twelve_data_client import STATE_PATH, reserve_request


@dataclass(frozen=True)
class RequestAuthorization:
    authorized: bool
    provider_credits_remaining: int
    local_budget_reserved: bool


def authorize_request(
    *,
    provider_state_path=DEFAULT_PATH,
    local_budget_path=STATE_PATH,
    now=None,
    required_credits=1,
    reserve_credits=20,
    max_age_seconds=300,
):
    if now is None:
        now = datetime.now(timezone.utc)

    provider_state_path = Path(provider_state_path)
    lock_path = provider_state_path.with_name(
        provider_state_path.name + ".lock"
    )

    lock_path.parent.mkdir(parents=True, exist_ok=True)

    with open(lock_path, "a+b") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)

        try:
            decision = check_before_request(
                path=provider_state_path,
                now=now,
                required_credits=required_credits,
                reserve_credits=reserve_credits,
                max_age_seconds=max_age_seconds,
            )

            snapshot = load_credit_state(
                path=provider_state_path,
                now=now,
                max_age_seconds=max_age_seconds,
            )

            # Local budget must succeed before provider state changes.
            reserve_request(
                path=local_budget_path,
                now=now,
            )

            remaining = snapshot.credits_left - required_credits

            updated = CreditSnapshot(
                credits_used=(
                    snapshot.credits_used + required_credits
                    if snapshot.credits_used is not None
                    else None
                ),
                credits_left=remaining,
                low_credits=remaining < reserve_credits,
                information_available=True,
            )

            save_credit_state(
                updated,
                path=provider_state_path,
                now=now,
            )

            return RequestAuthorization(
                authorized=True,
                provider_credits_remaining=remaining,
                local_budget_reserved=True,
            )

        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
