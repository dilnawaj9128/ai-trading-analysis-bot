"""Read-only inspection of incomplete authorization transactions.

Research-only:
- No provider API requests.
- No budget changes or refunds.
- No recovery-marker deletion.
- No trading execution.
"""

import fcntl
import json
import os
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path

from market_data.unified_request_guard import _load_ledger
from market_data.authorization_journal import (
    load_journal,
    AuthorizationJournalError,
)


@dataclass(frozen=True)
class RecoveryInspection:
    state: str
    request_id: str | None = None
    reason: str = ""


def _valid_marker(payload):
    if type(payload) is not dict:
        return False

    if payload.get("recovery_required") is not True:
        return False

    if payload.get("reason") != "authorization_commit_uncertain":
        return False

    request_id = payload.get("request_id")
    if (
        type(request_id) is not str
        or len(request_id) != 32
        or any(c not in "0123456789abcdef" for c in request_id)
    ):
        return False

    credits = payload.get("credits")
    if type(credits) is not int or credits < 1:
        return False

    authorized_at = payload.get("authorized_at")
    if type(authorized_at) is not str:
        return False

    try:
        observed = datetime.fromisoformat(authorized_at)
    except ValueError:
        return False

    if observed.tzinfo is None:
        return False

    return True


def inspect_recovery_state(provider_state_path):
    """Classify local recovery state without changing files."""

    provider_path = Path(provider_state_path)

    marker_path = provider_path.with_name(
        provider_path.name + ".recovery_required.json"
    )

    ledger_path = provider_path.with_name(
        provider_path.name + ".reservations.json"
    )

    lock_path = provider_path.with_name(
        provider_path.name + ".lock"
    )

    # Do not create directories during read-only inspection.
    if not provider_path.parent.exists():
        return RecoveryInspection("NO_RECOVERY")

    # Do not create a lock file during read-only inspection.
    # If recovery is pending but synchronization is unavailable,
    # classify conservatively rather than reading an unlocked ledger.
    if not lock_path.exists():
        if marker_path.exists():
            return RecoveryInspection(
                "INCONSISTENT",
                reason="Recovery pending but lock file missing",
            )

        return RecoveryInspection("NO_RECOVERY")

    # Open the existing lock file without modifying it.
    try:
        lock_file = open(lock_path, "rb")
    except OSError:
        return RecoveryInspection(
            "INCONSISTENT",
            reason="Recovery lock unavailable",
        )

    with lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_SH)

        try:
            # Verify that the locked descriptor still represents
            # the lock file currently reachable by its path.
            try:
                opened = os.fstat(lock_file.fileno())
                current = os.stat(lock_path)
            except OSError:
                return RecoveryInspection(
                    "INCONSISTENT",
                    reason="Recovery lock identity unavailable",
                )

            if (
                opened.st_dev != current.st_dev
                or opened.st_ino != current.st_ino
            ):
                return RecoveryInspection(
                    "INCONSISTENT",
                    reason="Recovery lock identity changed",
                )

            # Check independent authorization history before
            # declaring that no recovery is required.
            history_path = provider_path.with_name(
                provider_path.name + ".authorization_history.json"
            )
            journal_path = provider_path.with_name(
                provider_path.name + ".authorization_journal.json"
            )

            if history_path.exists():
                try:
                    history = json.loads(
                        history_path.read_text(encoding="utf-8")
                    )
                except (OSError, ValueError, TypeError):
                    return RecoveryInspection(
                        "INCONSISTENT",
                        reason="Authorization history unreadable",
                    )

                if (
                    type(history) is not dict
                    or type(history.get("version")) is not int
                    or history["version"] != 1
                    or history.get("initialized") is not True
                ):
                    return RecoveryInspection(
                        "INCONSISTENT",
                        reason="Invalid authorization history",
                    )

                if (
                    not journal_path.exists()
                    or not ledger_path.exists()
                ):
                    return RecoveryInspection(
                        "INCONSISTENT",
                        reason="Missing authorization evidence",
                    )

            # Validate journal/ledger consistency under the
            # existing shared provider lock.
            if journal_path.exists():
                try:
                    journal = load_journal(journal_path)
                    ledger = _load_ledger(ledger_path)
                except (
                    AuthorizationJournalError,
                    OSError,
                    ValueError,
                    TypeError,
                    KeyError,
                ):
                    return RecoveryInspection(
                        "INCONSISTENT",
                        reason="Invalid authorization evidence",
                    )

                transactions = journal["transactions"]
                requests = ledger["requests"]

                if set(transactions) != set(requests):
                    return RecoveryInspection(
                        "INCONSISTENT",
                        reason="Journal-ledger request mismatch",
                    )

                for request_id, transaction in transactions.items():
                    if (
                        transaction["credits"]
                        != requests[request_id]["credits"]
                    ):
                        return RecoveryInspection(
                            "INCONSISTENT",
                            request_id=request_id,
                            reason="Journal-ledger credit mismatch",
                        )

            if not marker_path.exists():
                return RecoveryInspection("NO_RECOVERY")

            try:
                marker = json.loads(marker_path.read_text())
            except (OSError, ValueError, TypeError):
                return RecoveryInspection(
                    "INCONSISTENT",
                    reason="Invalid recovery marker",
                )

            if not _valid_marker(marker):
                return RecoveryInspection(
                    "INCONSISTENT",
                    reason="Malformed recovery metadata",
                )

            request_id = marker["request_id"]

            try:
                ledger = _load_ledger(ledger_path)
            except (OSError, ValueError, TypeError, KeyError):
                return RecoveryInspection(
                    "INCONSISTENT",
                    request_id=request_id,
                    reason="Invalid reservation ledger",
                )

            entry = ledger["requests"].get(request_id)

            if entry is None:
                return RecoveryInspection(
                    "UNCOMMITTED",
                    request_id=request_id,
                    reason="Transaction absent from ledger",
                )

            if (
                entry["credits"] != marker["credits"]
                or entry["status"] != "PENDING"
                or entry.get("authorized_at")
                != marker["authorized_at"]
            ):
                return RecoveryInspection(
                    "INCONSISTENT",
                    request_id=request_id,
                    reason="Recovery marker and ledger mismatch",
                )

            return RecoveryInspection(
                "COMMITTED",
                request_id=request_id,
                reason="Matching local reservation found",
            )

        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
