import json
from datetime import datetime, timezone

from market_data.api_credit_monitor import CreditSnapshot
from market_data.provider_credit_state import save_credit_state
from market_data.unified_request_guard import authorize_request


NOW = datetime(2026, 11, 13, 12, 0, tzinfo=timezone.utc)


def setup_provider(tmp_path, left=100):
    path = tmp_path / "provider.json"

    save_credit_state(
        CreditSnapshot(
            credits_used=0,
            credits_left=left,
            low_credits=False,
            information_available=True,
        ),
        path=path,
        now=NOW,
    )

    return path


def test_authorization_creates_request_entry(tmp_path):
    provider = setup_provider(tmp_path)

    result = authorize_request(
        provider_state_path=provider,
        local_budget_path=tmp_path / "budget.json",
        now=NOW,
    )

    ledger = json.loads(
        (tmp_path / "provider.json.reservations.json").read_text()
    )

    assert result.authorized is True
    assert result.request_id
    assert ledger["reserved"] == 1
    assert ledger["requests"][result.request_id] == {
        "credits": 1,
        "status": "PENDING",
    }


def test_multiple_authorizations_have_unique_ids(tmp_path):
    provider = setup_provider(tmp_path)

    results = [
        authorize_request(
            provider_state_path=provider,
            local_budget_path=tmp_path / "budget.json",
            now=NOW,
        )
        for _ in range(2)
    ]

    ledger = json.loads(
        (tmp_path / "provider.json.reservations.json").read_text()
    )

    assert results[0].request_id != results[1].request_id
    assert ledger["reserved"] == 2
    assert len(ledger["requests"]) == 2


def test_legacy_ledger_is_not_silently_reset(tmp_path):
    provider = setup_provider(tmp_path)

    ledger_path = tmp_path / "provider.json.reservations.json"
    ledger_path.write_text(
        json.dumps({"version": 1, "reserved": 3})
    )

    result = authorize_request(
        provider_state_path=provider,
        local_budget_path=tmp_path / "budget.json",
        now=NOW,
    )

    ledger = json.loads(ledger_path.read_text())

    assert result.authorized is True
    assert ledger["reserved"] == 4
    assert ledger["legacy_reserved"] == 3
    assert ledger["requests"][result.request_id]["credits"] == 1
